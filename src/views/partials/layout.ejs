<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — DOGFOOD</title>
  <meta name="description" content="DOGFOOD hackathon judging platform" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: [
              'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont',
              '"Segoe UI"', 'Roboto', '"Helvetica Neue"', 'Arial', 'sans-serif'
            ]
          }
        }
      }
    }
  </script>
  <style>
  </style>
</head>
<body class="bg-gray-50 text-gray-900 font-sans min-h-screen">

  <header class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4 h-11 flex items-center justify-between">

      <a href="/" class="font-semibold text-sm tracking-tight text-gray-900 hover:text-blue-600">
        DOGFOOD
      </a>

      <nav class="flex items-center gap-5 text-sm text-gray-600">
        <a href="/projects" class="hover:text-gray-900 <%= currentPath === '/projects' ? 'text-gray-900 font-medium' : '' %>">Gallery</a>

        <% if (currentUser && currentUser.role === 'participant') { %>
          <a href="/projects/new" class="hover:text-gray-900 <%= currentPath === '/projects/new' ? 'text-gray-900 font-medium' : '' %>">Submit Project</a>
        <% } %>

        <% if (currentUser && currentUser.role === 'judge') { %>
          <a href="/judge/dashboard" class="hover:text-gray-900 <%= currentPath === '/judge/dashboard' ? 'text-gray-900 font-medium' : '' %>">My Scoring Queue</a>
        <% } %>

        <% if (currentUser && currentUser.role === 'organizer') { %>
          <a href="/organizer/dashboard" class="hover:text-gray-900 <%= currentPath === '/organizer/dashboard' ? 'text-gray-900 font-medium' : '' %>">Dashboard</a>
          <a href="/api/export/csv" class="hover:text-gray-900">Export CSV</a>
        <% } %>

        <% if (!currentUser) { %>
          <span class="text-gray-400 text-xs">No session</span>
        <% } else { %>
          <span class="text-xs text-gray-400 border-l border-gray-200 pl-4"><%= currentUser.role %></span>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <%- body %>
  </main>

</body>
</html>
