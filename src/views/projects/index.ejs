<%# views/projects/index.ejs — Public Gallery %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-gray-900">Project Gallery</h1>
  <% if (currentUser && currentUser.role === 'participant') { %>
    <a href="/projects/new" class="text-sm bg-blue-600 text-white px-3 py-1.5 rounded-sm hover:bg-blue-700">Submit Project</a>
  <% } %>
</div>

<%# Filters %>
<div class="flex items-center gap-3 mb-4">
  <input
    id="search-input"
    type="text"
    placeholder="Search by title..."
    class="border border-gray-200 rounded-sm text-sm px-2.5 py-1.5 w-56 focus:outline-none focus:border-gray-400"
  />
  <select
    id="track-filter"
    class="border border-gray-200 rounded-sm text-sm px-2.5 py-1.5 focus:outline-none focus:border-gray-400 bg-white"
  >
    <option value="">All tracks</option>
    <% tracks.forEach(function(t) { %>
      <option value="<%= t %>"><%= t %></option>
    <% }) %>
  </select>
  <span id="result-count" class="text-xs text-gray-400 ml-auto"></span>
</div>

<%# Projects table %>
<div class="border border-gray-200 rounded-sm overflow-hidden">
  <table class="w-full text-sm" id="projects-table">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="text-left px-4 py-2.5 font-medium text-gray-600 w-2/5">Title</th>
        <th class="text-left px-4 py-2.5 font-medium text-gray-600 w-2/5">Summary</th>
        <th class="text-left px-4 py-2.5 font-medium text-gray-600 w-1/5">Track</th>
      </tr>
    </thead>
    <tbody id="projects-body">
      <% if (projects.length === 0) { %>
        <tr>
          <td colspan="3" class="px-4 py-6 text-gray-400 text-center">No projects submitted yet.</td>
        </tr>
      <% } %>
      <% projects.forEach(function(p) { %>
        <tr
          class="border-t border-gray-100 hover:bg-gray-50 project-row"
          data-title="<%= p.title.toLowerCase() %>"
          data-track="<%= p.track %>"
        >
          <td class="px-4 py-2.5 font-medium">
            <a href="/projects/<%= p.id %>" class="text-blue-600 hover:underline"><%= p.title %></a>
          </td>
          <td class="px-4 py-2.5 text-gray-600"><%= p.summary %></td>
          <td class="px-4 py-2.5">
            <span class="text-xs border border-gray-200 rounded-sm px-1.5 py-0.5 text-gray-600"><%= p.track %></span>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
  (function () {
    const searchInput = document.getElementById('search-input');
    const trackFilter = document.getElementById('track-filter');
    const rows = document.querySelectorAll('.project-row');
    const countEl = document.getElementById('result-count');

    function applyFilters() {
      const query = searchInput.value.toLowerCase().trim();
      const track = trackFilter.value;
      let visible = 0;

      rows.forEach(function (row) {
        const titleMatch = !query || row.dataset.title.includes(query);
        const trackMatch = !track || row.dataset.track === track;
        const show = titleMatch && trackMatch;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      countEl.textContent = visible + ' of ' + rows.length + ' projects';
    }

    searchInput.addEventListener('input', applyFilters);
    trackFilter.addEventListener('change', applyFilters);
    applyFilters();
  })();
</script>
