<%# views/projects/show.ejs — Project Detail Page %>

<div class="mb-4">
  <a href="/projects" class="text-sm text-blue-600 hover:underline">&larr; Back to Gallery</a>
</div>

<div class="border border-gray-200 rounded-sm bg-white p-5 mb-5">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold text-gray-900 mb-1"><%= project.title %></h1>
      <p class="text-gray-600 text-sm mb-3"><%= project.summary %></p>
      <span class="text-xs border border-gray-200 rounded-sm px-1.5 py-0.5 text-gray-600"><%= project.track %></span>
    </div>
  </div>
</div>

<table class="text-sm w-full max-w-md">
  <tbody class="divide-y divide-gray-100">
    <tr>
      <td class="py-2 pr-6 text-gray-500 w-32">Team</td>
      <td class="py-2 text-gray-900"><%= project.team %></td>
    </tr>
    <tr>
      <td class="py-2 pr-6 text-gray-500">Repo</td>
      <td class="py-2">
        <a href="<%= project.repo_url %>" target="_blank" rel="noopener"
           class="text-blue-600 hover:underline break-all"><%= project.repo_url %></a>
      </td>
    </tr>
    <tr>
      <td class="py-2 pr-6 text-gray-500">Submitted</td>
      <td class="py-2 text-gray-900"><%= new Date(project.submitted_at).toUTCString() %></td>
    </tr>
    <tr>
      <td class="py-2 pr-6 text-gray-500">Track</td>
      <td class="py-2 text-gray-900"><%= project.track %></td>
    </tr>
  </tbody>
</table>
