<%# views/projects/new.ejs — Project Submission Form %>

<div class="max-w-lg">
  <h1 class="text-xl font-semibold text-gray-900 mb-1">Submit a Project</h1>
  <p class="text-sm text-gray-500 mb-6">Fill out the form below. All fields are required.</p>

  <%# Error / success banners (populated by JS) %>
  <div id="msg-error" class="hidden mb-4 border border-red-300 bg-red-50 text-red-700 rounded-sm px-3 py-2 text-sm"></div>
  <div id="msg-success" class="hidden mb-4 border border-green-300 bg-green-50 text-green-700 rounded-sm px-3 py-2 text-sm"></div>

  <form id="submit-form" class="space-y-4">
    <div>
      <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        required
        maxlength="120"
        class="border border-gray-200 rounded-sm text-sm px-2.5 py-1.5 w-full focus:outline-none focus:border-gray-400"
        placeholder="e.g. Hollow Signal"
      />
    </div>

    <div>
      <label for="summary" class="block text-sm font-medium text-gray-700 mb-1">One-line Summary</label>
      <input
        type="text"
        id="summary"
        name="summary"
        required
        maxlength="200"
        class="border border-gray-200 rounded-sm text-sm px-2.5 py-1.5 w-full focus:outline-none focus:border-gray-400"
        placeholder="What does your project do in one sentence?"
      />
    </div>

    <div>
      <label for="repo_url" class="block text-sm font-medium text-gray-700 mb-1">Repo URL</label>
      <input
        type="url"
        id="repo_url"
        name="repo_url"
        required
        class="border border-gray-200 rounded-sm text-sm px-2.5 py-1.5 w-full focus:outline-none focus:border-gray-400"
        placeholder="https://github.com/your-org/your-repo"
      />
    </div>

    <div class="pt-1">
      <button
        type="submit"
        id="submit-btn"
        class="bg-blue-600 text-white text-sm px-4 py-1.5 rounded-sm hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Submit Project
      </button>
    </div>
  </form>
</div>

<script>
  (function () {
    const form    = document.getElementById('submit-form');
    const errBox  = document.getElementById('msg-error');
    const okBox   = document.getElementById('msg-success');
    const btn     = document.getElementById('submit-btn');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errBox.classList.add('hidden');
      okBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const payload = {
        title:    document.getElementById('title').value.trim(),
        summary:  document.getElementById('summary').value.trim(),
        repo_url: document.getElementById('repo_url').value.trim()
      };

      try {
        const res = await fetch('/projects/new', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          okBox.textContent = 'Project submitted successfully.';
          okBox.classList.remove('hidden');
          form.reset();
        } else {
          let msg = 'An error occurred. Please try again.';
          try {
            const body = await res.json();
            if (body && body.error) {
              // Surface backend error in a readable way
              if (body.error === 'submissions are closed') {
                msg = 'Submissions are closed.';
              } else if (body.error === 'unauthorized') {
                msg = 'You are not authorized to submit a project. Make sure you are logged in as a participant.';
              } else {
                msg = body.error;
              }
            }
          } catch (_) {}
          errBox.textContent = msg;
          errBox.classList.remove('hidden');
        }
      } catch (err) {
        errBox.textContent = 'Network error — could not reach the server.';
        errBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Submit Project';
      }
    });
  })();
</script>
